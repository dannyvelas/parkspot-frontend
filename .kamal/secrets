# ghcr.io auth: GitHub Actions' own GITHUB_TOKEN, passed into the CI job
# as KAMAL_REGISTRY_PASSWORD by .github/workflows/deploy.yml. Not pulled
# from Bitwarden; see backend-parkspot/specs/.../research.md Decision 3/4.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Application secrets, resolved at deploy time from the Bitwarden Secrets
# Manager project via the bws CLI. BWS_ACCESS_TOKEN comes from the CI job's
# own environment (GitHub Actions secret), never from this repo. Kamal
# parses this file as dotenv with inline command substitution, not as a
# bash script, and each line's $(...) appears to run as its own
# independent subprocess, so a shell variable set on one line isn't
# reliably visible to another. Fetched once to a local temp file instead,
# which every extraction line reads independently, then the temp file is
# removed on the last line.
BWS_PROJECT_ID=c902bd7c-b27c-4791-bab1-b4e5003dac58
BWS_FETCH=$(bws secret list "$BWS_PROJECT_ID" --access-token "$BWS_ACCESS_TOKEN" --output json > /tmp/kamal-bws-secrets-frontend.json && echo ok)

TOKEN_REFRESHSECRET=$(jq -r '.[] | select(.key=="TOKEN_REFRESHSECRET") | .value' /tmp/kamal-bws-secrets-frontend.json)

BWS_CLEANUP=$(rm -f /tmp/kamal-bws-secrets-frontend.json && echo ok)
